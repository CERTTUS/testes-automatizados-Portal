  "description": "Suíte Playwright — Portal do Cliente (QA_PRE_CR + E2E pontual)",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test --project=chromium",
    "test:modulo-talk-2669": "playwright test tests/smoke/modulo-talk-2638/CT-SMK-autenticado.spec.ts tests/e2e/specs/modulo-talk-2669-shell-d4/shell-d4-portal.spec.ts --project=chromium",
    "test:modulo-talk-2670": "playwright test tests/smoke/modulo-talk-2638/CT-SMK-05-d4-conteudo.spec.ts tests/e2e/specs/modulo-talk-2670-d4-conteudo/d4-conteudo-portal.spec.ts --project=chromium",
    "test:modulo-talk-2671": "playwright test tests/smoke/modulo-talk-2638/CT-SMK-06-sem-timeline.spec.ts tests/e2e/specs/modulo-talk-2671-painel-detalhe/painel-detalhe-portal.spec.ts --project=chromium",
    "test:modulo-talk-2668": "playwright test tests/api/modulo-talk-2638/CT-API-landing.spec.ts tests/smoke/modulo-talk-2638/CT-SMK-d1-login.spec.ts tests/e2e/specs/modulo-talk-2668-d1-testes --project=chromium",
