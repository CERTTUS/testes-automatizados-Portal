    "pre-cr:bootstrap": "node scripts/pre-cr/bootstrap-modulo.mjs",
    "pre-cr:iniciar-rodada": "node scripts/pre-cr/iniciar-rodada.mjs",
    "pre-cr:renomear-runs": "node scripts/pre-cr/renomear-runs-legado.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.1",
