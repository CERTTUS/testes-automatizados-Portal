E2E_BASE_URL=http://localhost:3000
E2E_API_BASE_URL=http://127.0.0.1:3333

# Massa local — copie para .env.local (gitignored)
# E2E_TEST_TELEFONE=+5511999999999

# PRE_CR=1 é injetado por npm run test:pre-cr
# E2E_USE_CHROMIUM=1
# E2E_REPORTER_LISTA=1

# --- Modulo portal-link-409-ctoken (URG-10463) ---
# API sob teste (sempre local) e chave (valor so no .env.local)
# PORTAL_MS_BASE_URL=http://localhost:8085/api/v1/servicos
# PORTAL_MS_DATABASE=portaldocliente
# PORTAL_MS_CHAVEAPI=
# Banco LOCAL do tenant (so localhost/127.0.0.1 e banco portaldocliente; senao a suite recusa). Valor real so no .env.local
# PORTAL_TEST_DB_URL=postgresql://<usuario>:<senha>@localhost:5432/portaldocliente
# Qual Supabase a API usa: prod | dev (ausente = prod). Em prod a escrita exige o opt-in abaixo.
# PORTAL_MS_SUPABASE_ENV=dev
# Opt-in consciente para gravar no Supabase de PRODUCAO - exporte na sessao do terminal, NAO grave no .env.local:
#   PowerShell: $env:PORTAL_ALLOW_PROD_WRITE='1'
# PORTAL_ALLOW_PROD_WRITE=

# --- Massa do modulo portal-link-409-ctoken: cada spec CRIA a propria OS via api-mobile (banco LOCAL; nao vale p/ producao) ---
# Autoriza gravar OS no banco local do ERP (exporte na sessao; mesmo nome usado no repo Touch):
#   PowerShell: $env:TOUCH_API_OS_GRAVAR='1'
# api-mobile local (default abaixo; so localhost/127.0.0.1)
# PORTAL_APIMOBILE_BASE=http://localhost:8086/api/v1
# Credenciais do usuario da api-mobile (valor so no .env.local; ver loginTeste do harness-handoff.json)
# PORTAL_APIMOBILE_USUARIO=
# PORTAL_APIMOBILE_SENHA=
# Opcional: serial do dispositivo ja vinculado ao usuario (senao usa os seriais de mobiledispositivos, via SELECT)
# PORTAL_APIMOBILE_DISPOSITIVO_SERIAL=
# Opcional: so api-mobile NUVEM (header empresa)
# PORTAL_APIMOBILE_CONEXAO=
# Opcionais da OS (default: operacao descoberta via GET, cliente sem cadastro/consumidor final; sem veiculo/mecanica/motor)
# PORTAL_OS_OPERACAO=
# PORTAL_OS_MECANICA=
# PORTAL_OS_VEICULO=
# PORTAL_OS_MOTOR=
# Espera (ms) pelo link que a propria api-mobile emite ao gravar a OS, antes do teste revogar e comecar limpo (default 8000)
# PORTAL_ESPERA_LINK_AUTO_MS=8000
# Ciencia de que a api-mobile pode ENVIAR WhatsApp ao celular ficticio da OS (empresa 0001 com envio de link ligado). Exporte na sessao:
#   PowerShell: $env:PORTAL_ACEITA_WHATSAPP_REAL='1'

# Celular REAL do QA (unico real permitido); definir so em .env.local
PORTAL_TELEFONE_QA_REAL=
